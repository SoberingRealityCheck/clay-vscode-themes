{
  "name": "Forest and Bark",
  "type": "light",
  "colors": {
    "editor.background": "#ffffff",
    "editor.foreground": "#222222",
    "editor.selectionBackground": "#dfe9d8",
    "editor.inactiveSelectionBackground": "#edf2e8",
    "editor.lineHighlightBackground": "#f4f6f2",
    "editor.findMatchBackground": "#d9e6c0",
    "editor.findMatchHighlightBackground": "#e8eed6",
    "editorCursor.foreground": "#4a7c55",
    "editorLineNumber.foreground": "#b3baae",
    "editorLineNumber.activeForeground": "#4a7c55",
    "editorIndentGuide.background1": "#eceee8",
    "editorIndentGuide.activeBackground1": "#c9d0c2",
    "editorWhitespace.foreground": "#dde1d8",
    "editorBracketMatch.background": "#e3ecdb",
    "editorBracketMatch.border": "#4a7c55",
    "editorGroup.border": "#e0e5dc",
    "editorGroupHeader.tabsBackground": "#f4f6f2",

    "activityBar.background": "#f4f6f2",
    "activityBar.foreground": "#4a7c55",
    "activityBar.inactiveForeground": "#8a9484",
    "activityBar.border": "#e0e5dc",
    "activityBarBadge.background": "#2f6aa3",
    "activityBarBadge.foreground": "#ffffff",

    "sideBar.background": "#f8f9f6",
    "sideBar.foreground": "#222222",
    "sideBar.border": "#e0e5dc",
    "sideBarTitle.foreground": "#4a7c55",
    "sideBarSectionHeader.background": "#f1f4ed",

    "list.activeSelectionBackground": "#dfe9d8",
    "list.activeSelectionForeground": "#222222",
    "list.inactiveSelectionBackground": "#e9efe2",
    "list.hoverBackground": "#eef2ea",
    "list.focusBackground": "#dfe9d8",

    "tab.activeBackground": "#ffffff",
    "tab.activeForeground": "#222222",
    "tab.activeBorderTop": "#4a7c55",
    "tab.inactiveBackground": "#f4f6f2",
    "tab.inactiveForeground": "#7f8a79",
    "tab.border": "#e0e5dc",

    "statusBar.background": "#4a7c55",
    "statusBar.foreground": "#ffffff",
    "statusBar.noFolderBackground": "#86644a",
    "statusBar.debuggingBackground": "#86644a",

    "titleBar.activeBackground": "#f4f6f2",
    "titleBar.activeForeground": "#222222",
    "titleBar.inactiveBackground": "#f4f6f2",
    "titleBar.border": "#e0e5dc",

    "panel.background": "#ffffff",
    "panel.border": "#e0e5dc",
    "panelTitle.activeBorder": "#4a7c55",
    "panelTitle.activeForeground": "#222222",
    "panelTitle.inactiveForeground": "#7f8a79",

    "button.background": "#4a7c55",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#3f6a49",
    "input.background": "#ffffff",
    "input.border": "#cfd6c8",
    "focusBorder": "#2f6aa3",
    "textLink.foreground": "#1b7d86",
    "textLink.activeForeground": "#2f6aa3",
    "badge.background": "#2f6aa3",
    "badge.foreground": "#ffffff",

    "gitDecoration.modifiedResourceForeground": "#66782f",
    "gitDecoration.addedResourceForeground": "#4a7c55",
    "gitDecoration.untrackedResourceForeground": "#4a7c55",
    "gitDecoration.deletedResourceForeground": "#a8473a",

    "terminal.background": "#ffffff",
    "terminal.foreground": "#222222",
    "terminalCursor.foreground": "#4a7c55",
    "terminal.ansiBlack": "#222222",
    "terminal.ansiRed": "#a8473a",
    "terminal.ansiGreen": "#4a7c55",
    "terminal.ansiYellow": "#86644a",
    "terminal.ansiBlue": "#2f6aa3",
    "terminal.ansiMagenta": "#7a5a86",
    "terminal.ansiCyan": "#1b7d86",
    "terminal.ansiWhite": "#c9cfc2",
    "terminal.ansiBrightBlack": "#7f8a79",
    "terminal.ansiBrightRed": "#bd5a4b",
    "terminal.ansiBrightGreen": "#5e8f68",
    "terminal.ansiBrightYellow": "#66782f",
    "terminal.ansiBrightBlue": "#4580bd",
    "terminal.ansiBrightMagenta": "#8f6e9b",
    "terminal.ansiBrightCyan": "#2b929c",
    "terminal.ansiBrightWhite": "#e0e5dc"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7f8a79", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#4a7c55" } },
    { "scope": ["string", "string.quoted", "punctuation.definition.string"], "settings": { "foreground": "#86644a" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character.escape"], "settings": { "foreground": "#1b7d86" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#2f6aa3" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class"], "settings": { "foreground": "#66782f" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#4a7c55" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#66782f" } },
    { "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator"], "settings": { "foreground": "#66782f" } },
    { "scope": ["variable", "variable.other", "variable.parameter"], "settings": { "foreground": "#222222" } },
    { "scope": ["variable.language", "variable.other.constant"], "settings": { "foreground": "#1b7d86" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#222222" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#4a7c55", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#1b7d86" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#86644a" } },
    { "scope": ["invalid"], "settings": { "foreground": "#a8473a" } }
  ]
}
